# secrets — never commit
.env
.env.*
*.key

# python
__pycache__/
*.pyc
.ipynb_checkpoints/

# memory library artifacts (rebuildable, GB-scale) — see REPRODUCING.md
emo/memory/*_chroma*/
emo/memory/*_sqlite*/
*.db
*.sqlite3

